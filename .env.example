# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...
# Service role key: used only by server routes (cron, admin). NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=xxxx

# ---- Google OAuth (Gmail send + login) ----
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx
# Must match the redirect URI you registered in Google Cloud
# In local dev: http://localhost:3000/auth/callback
# In prod:     https://your-domain.com/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# ---- Application ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- URSSAF (when API credentials arrive) ----
URSSAF_API_BASE_URL=
URSSAF_CLIENT_ID=
URSSAF_CLIENT_SECRET=
# Set to "true" once credentials are provided to stop using the mock adapter
URSSAF_LIVE=false

# ---- Cron security ----
# Random string used to authenticate Vercel cron calls.
CRON_SECRET=change-me-to-a-random-string

# ---- Mistral AI ----
# Used by the "polish description" magic-wand button when creating an invoice.
# Create a key at https://console.mistral.ai/
MISTRAL_API_KEY=
