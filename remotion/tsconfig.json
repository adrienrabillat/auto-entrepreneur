{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noUnusedLocals": false,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["@types/web"]
  },
  "include": ["src", "remotion.config.ts"]
}
